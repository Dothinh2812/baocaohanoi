{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question_batch.schema.json",
  "title": "AI Question Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch", "questions"],
  "properties": {
    "schema_version": {"type": "string"},
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language", "source_document_version_ids", "target_audience_codes", "requested_count"],
      "properties": {
        "title": {"type": "string"},
        "language": {"type": "string"},
        "source_document_version_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "target_audience_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "requested_count": {"type": "integer", "minimum": 1}
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_ref", "type", "stem", "options", "correct_option_ids", "classification", "difficulty", "evidence"],
        "properties": {
          "local_ref": {"type": "string"},
          "type": {"type": "string", "enum": ["single_choice"]},
          "stem": {"type": "string", "minLength": 1},
          "stimulus": {"type": ["string", "null"]},
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1}
              }
            }
          },
          "correct_option_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "explanation": {"type": ["string", "null"]},
          "distractor_rationales": {"type": ["object", "null"]},
          "classification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "domain_code": {"type": "string"},
              "category_code": {"type": "string"},
              "indicator_codes": {"type": "array", "items": {"type": "string"}},
              "topic_codes": {"type": "array", "items": {"type": "string"}},
              "competency_codes": {"type": "array", "items": {"type": "string"}},
              "audience_codes": {"type": "array", "items": {"type": "string"}},
              "service_codes": {"type": "array", "items": {"type": "string"}},
              "tags": {"type": "array", "items": {"type": "string"}}
            }
          },
          "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
          "cognitive_level": {"type": ["string", "null"]},
          "criticality": {"type": ["string", "null"]},
          "estimated_seconds": {"type": ["integer", "null"], "minimum": 0},
          "calculation": {"type": ["object", "null"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["document_version_id", "block_id", "extraction_revision", "supports"],
              "properties": {
                "document_version_id": {"type": "string"},
                "block_id": {"type": "string"},
                "extraction_revision": {"type": "integer", "minimum": 1},
                "quoted_text": {"type": ["string", "null"]},
                "quote_start": {"type": ["integer", "null"]},
                "quote_end": {"type": ["integer", "null"]},
                "supports": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
